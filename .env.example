# ─── Database ───────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ─── Supabase ────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ─── RapidAPI / JSearch ──────────────────────────────────────────
RAPIDAPI_KEY="your-rapidapi-key"
JSEARCH_BASE_URL="https://jsearch.p.rapidapi.com"

# ─── Adzuna ──────────────────────────────────────────────────────
ADZUNA_APP_ID="your-adzuna-app-id"
ADZUNA_APP_KEY="your-adzuna-app-key"
ADZUNA_BASE_URL="https://api.adzuna.com/v1/api"

# ─── Arbeitnow (no auth required, but kept for completeness) ─────
ARBEITNOW_BASE_URL="https://www.arbeitnow.com/api/job-board-api"

# ─── OpenAI (optional, for semantic search / embeddings) ─────────
OPENAI_API_KEY="your-openai-api-key"

# ─── App ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CRON_SECRET="your-cron-secret-token"

# ─── Vercel (auto-set in Vercel deployments) ─────────────────────
# VERCEL_URL is automatically set by Vercel
