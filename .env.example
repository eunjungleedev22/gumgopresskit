# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN="your-bot-token"

# ─── Job APIs ─────────────────────────────────────────────────────────────────
# JSearch via RapidAPI — rapidapi.com (subscribe to JSearch)
RAPIDAPI_KEY="your-rapidapi-key"

# Adzuna — developer.adzuna.com
ADZUNA_APP_ID="your-adzuna-app-id"
ADZUNA_APP_KEY="your-adzuna-app-key"

# Arbeitnow — no auth needed (public EU remote jobs API)

# ─── OpenAI (optional — semantic search) ─────────────────────────────────────
OPENAI_API_KEY="your-openai-api-key"

# ─── Cron auth (only needed if running the Next.js web layer) ────────────────
CRON_SECRET="your-secure-random-string"
